# ==========================================
# Bempedi - Configurações de Ambiente (.env)
# ==========================================

# ------------------------------------------
# 1. Domínio & Aplicação
# ------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://bempedi.com

# ------------------------------------------
# 2. Appwrite Backend
# ------------------------------------------
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=bempedi

# Appwrite Collections
APPWRITE_PROFILES_COLLECTION_ID=profiles
APPWRITE_ESTABLISHMENTS_COLLECTION_ID=establishments
APPWRITE_PRODUCTS_COLLECTION_ID=products
APPWRITE_CATEGORIES_COLLECTION_ID=categories
APPWRITE_TABLES_COLLECTION_ID=tables
APPWRITE_TABLE_SESSIONS_COLLECTION_ID=table_sessions
APPWRITE_SERVICE_CALLS_COLLECTION_ID=service_calls
APPWRITE_ORDERS_COLLECTION_ID=orders

# ------------------------------------------
# 3. Asaas Gateway de Pagamentos
# Sandbox: https://sandbox.asaas.com/api/v3
# Produção: https://api.asaas.com/v3
# ------------------------------------------
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# ------------------------------------------
# 4. Segurança & Criptografia de Sessões
# ENCRYPTION_KEY: Chave secreta de 32 bytes para criptografia AES-256-GCM das subcontas Asaas
# SESSION_SECRET: Segredo para assinatura HMAC-SHA256 dos tokens de participantes na mesa
# ------------------------------------------
ENCRYPTION_KEY=
SESSION_SECRET=

# ------------------------------------------
# 5. Cloudflare R2 / AWS S3 Storage
# ------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bempedi-storage
NEXT_PUBLIC_R2_URL=https://pub-your-id.r2.dev

# ------------------------------------------
# 6. SEO & Google
# ------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

